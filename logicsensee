function Graphics:RevertVisuals()
	local lib = self._lib
	if lib then
		for _, flag in ipairs(self._visToggles or {}) do
			local o = lib.Options[flag]
			if o then
				o:Set(false)
			end
		end
	end
	if lib and lib.Options["weather_type"] then
		lib.Options["weather_type"]:Set("Off")
	end
	Character:Destroy()
	Custom:Destroy()
	World:Reset()
	Weather:Clear()
	Overlay:Destroy()
	CameraMod:Destroy()
end

