function Sky:_clear()
	for _, d in ipairs(Lighting:GetChildren()) do
		if isOurs(d) and (d:IsA("Sky") or d.Name == PREFIX .. "SkyAtmo") then
			d:Destroy()
		end
	end
	local terrain = workspace.Terrain
	local c = terrain:FindFirstChild(PREFIX .. "SkyClouds")
	if c then
		c:Destroy()
	end
end

function Sky:Apply(name)
	restore(self.tr)
	self:_clear()
	self.Current = name or "Off"
	local p = self.Presets[self.Current]
	if not p then
		return
	end
	for _, d in ipairs(Lighting:GetChildren()) do
		if d:IsA("Sky") and not isOurs(d) then
			detach(self.tr, d)
		end
	end
	local sky = Instance.new("Sky")
	sky.Name = PREFIX .. "Sky"
	local f = p.Faces or DEFAULT_FACES
	sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = f.Bk, f.Dn, f.Ft
	sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = f.Lf, f.Rt, f.Up
	sky.StarCount = p.StarCount or 3000
	sky.CelestialBodiesShown = p.Bodies ~= false
	sky.SunAngularSize = p.Sun or 21
	sky.MoonAngularSize = p.Moon or 11
	sky.Parent = Lighting
	for k, v in pairs(p.Light or {}) do
		track(self.tr, Lighting, k, v)
	end
	if p.Atmo then
		-- only one Atmosphere is active: park the game's own and any shader-preset one
		for _, d in ipairs(Lighting:GetChildren()) do
			if d:IsA("Atmosphere") and not isOurs(d) then
				detach(self.tr, d)
			elseif d.Name == PREFIX .. "Atmosphere" then
				d:Destroy()
			end
		end
		local a = Instance.new("Atmosphere")
		a.Name = PREFIX .. "SkyAtmo"
		a:SetAttribute("Custom", true) -- survives the shader preset cleanup
		a.Density = p.Atmo.Density or 0.3
		a.Offset = p.Atmo.Offset or 0
		a.Color = p.Atmo.Color or Color3.new(1, 1, 1)
		a.Decay = p.Atmo.Decay or Color3.new(0, 0, 0)
		a.Glare = p.Atmo.Glare or 0
		a.Haze = p.Atmo.Haze or 0
		a.Parent = Lighting
	end
	if p.Clouds then
		local terrain = workspace.Terrain
		for _, c in ipairs(terrain:GetChildren()) do
			if c:IsA("Clouds") and not isOurs(c) then
				track(self.tr, c, "Enabled", false)
			end
		end
		local c = Instance.new("Clouds")
		c.Name = PREFIX .. "SkyClouds"
		c.Cover = p.Clouds.Cover or 0.5
		c.Density = p.Clouds.Density or 0.5
		c.Color = p.Clouds.Color or Color3.new(1, 1, 1)
		c.Parent = terrain
	end
	-- re-apply any sky tweaks from the World tab (star count, sun size, ...)
	if Graphics.World then
		Graphics.World:ApplySky()
	end
end

function Sky:SetTime(t)
	track(self.tr, Lighting, "ClockTime", t)
end

-- "bk,dn,ft,lf,rt,up"  (asset IDs or full rbxassetid:// strings). One ID = same image on all faces.
function Sky:ApplyCustom(str)
	local ids = {}
	for token in string.gmatch(str or "", "[^,%s]+") do
		ids[#ids + 1] = tonumber(token) and ("rbxassetid://" .. token) or token
	end
	if #ids == 0 then
		return false
	end
	local faces = {}
	for i, key in ipairs(FACE_KEYS) do
		faces[key] = ids[i] or ids[1]
	end
	self.Presets["Custom"] = { Faces = faces, StarCount = 0, Bodies = false, Light = { ClockTime = 14 } }
	self:Apply("Custom")
	return true
end

