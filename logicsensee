	---------------------------------------------------------------- baseline snapshot (menu defaults)
	local baseline = {}
	for flag, opt in pairs(O) do
		local v = opt.Value
		-- sky_time is left out: picking a skybox moves it, and the reset must not undo that
		if not opt.NoConfig and v ~= nil and type(v) ~= "table" and flag ~= "sky_time" then
			baseline[flag] = v
		end
	end

	local function applyFree(b)
		Library:ApplyConfig(merge(baseline, b.data), false)
	end

	---------------------------------------------------------------- executor file system (optional)
	local function fsOK()
		return type(writefile) == "function" and type(readfile) == "function" and type(isfolder) == "function"
			and type(makefolder) == "function" and type(listfiles) == "function"
	end
	local mem = {} -- name -> json (used when there is no file system, and as a cache)
	local function path(name)
		return FOLDER .. "/" .. name .. ".json"
	end
	local function clean(name)
		name = tostring(name or ""):gsub("[^%w _%-]", ""):gsub("^%s+", ""):gsub("%s+$", "")
		return name
	end
	local function savedNames()
		local set = {}
		for n in pairs(mem) do
			set[n] = true
		end
		if fsOK() then
			pcall(function()
				if not isfolder(FOLDER) then
					makefolder(FOLDER)
				end
				for _, p in ipairs(listfiles(FOLDER)) do
					local n = string.match(p, "([^/\\]+)%.json$")
					if n then
						set[n] = true
					end
				end
			end)
		end
		local out = {}
		for n in pairs(set) do
			out[#out + 1] = n
		end
		table.sort(out)
		return out
	end
	local function readSaved(name)
		if mem[name] then
			return mem[name]
		end
		if fsOK() then
			local ok, res = pcall(function()
				return readfile(path(name))
			end)
			if ok then
				return res
			end
		end
	end
	local function writeSaved(name, json)
		mem[name] = json
		if fsOK() then
			pcall(function()
				if not isfolder(FOLDER) then
					makefolder(FOLDER)
				end
				writefile(path(name), json)
			end)
		end
	end

	---------------------------------------------------------------- UI
	local tab = Window:AddTab("Configs")
	local lg = tab:AddGroup("Configs", "Left")
	local desc

	local function values()
		local v = {}
		for _, b in ipairs(BUILTIN) do
			v[#v + 1] = FREE .. b.name
		end
		for _, n in ipairs(savedNames()) do
			v[#v + 1] = n
		end
		return v
	end
	local function builtinFor(sel)
		if string.sub(sel or "", 1, #FREE) == FREE then
			local n = string.sub(sel, #FREE + 1)
			for _, b in ipairs(BUILTIN) do
				if b.name == n then
					return b
				end
			end
		end
	end

	local list = lg:AddDropdown("cfg_list", {
		Text = "Config",
		NoConfig = true,
		Values = values(),
		Default = 1,
		Callback = function(sel)
			local b = builtinFor(sel)
			if desc then
				desc:SetText(b and b.desc or "Saved config.")
			end
		end,
	})
	desc = lg:AddLabel(BUILTIN[1].desc)

	lg:AddButton("Load selected", function()
		local sel = list.Value
		local b = builtinFor(sel)
		if b then
			applyFree(b)
			Library:Notify("Loaded config: " .. b.name, 3)
			return
		end
		local json = readSaved(sel)
		if json and Library:ImportConfig(json) then
			Library:Notify("Loaded config: " .. tostring(sel), 3)
		else
			Library:Notify("Could not load that config", 3)
		end
	end)
	lg:AddButton("Overwrite selected (saved only)", function()
		local sel = list.Value
		if builtinFor(sel) then
			Library:Notify("Free configs are read-only - use 'Save as new'", 3)
			return
		end
		writeSaved(sel, Library:ExportConfig())
		Library:Notify("Saved: " .. tostring(sel), 3)
	end)
	lg:AddButton("Delete selected (saved only)", function()
		local sel = list.Value
		if builtinFor(sel) then
			Library:Notify("Free configs can't be deleted", 3)
			return
		end
		mem[sel] = nil
		if fsOK() and type(delfile) == "function" then
			pcall(delfile, path(sel))
		end
		list:SetValues(values())
		list:Set(list.Values[1])
		Library:Notify("Deleted: " .. tostring(sel), 3)
	end)
	lg:AddButton("Refresh list", function()
		list:SetValues(values())
	end)

	local sg = tab:AddGroup("Save current settings", "Left")
	local nameBox = sg:AddTextbox("cfg_name", { Text = "Config name", Placeholder = "my config", NoConfig = true })
	sg:AddButton("Save as new", function()
		local name = clean(nameBox.Value)
		if name == "" then
			Library:Notify("Type a config name first", 3)
			return
		end
		writeSaved(name, Library:ExportConfig())
		list:SetValues(values())
		list:Set(name)
		Library:Notify("Saved config: " .. name, 3)
	end)
	sg:AddLabel(fsOK() and "Saved to your executor's workspace folder." or "No file access: configs last until you leave.")

	local rg = tab:AddGroup("Share & reset", "Right")
	local jsonBox = rg:AddTextbox("cfg_json", { Text = "Config JSON", Placeholder = "paste a config here", NoConfig = true })
	rg:AddButton("Export current (copy)", function()
		local json = Library:ExportConfig()
		jsonBox:Set(json)
		local clip = setclipboard or toclipboard
		if type(clip) == "function" and pcall(clip, json) then
			Library:Notify("Config copied to clipboard", 3)
		else
			Library:Notify("Config placed in the box above", 3)
		end
	end)
	rg:AddButton("Import from box", function()
		if Library:ImportConfig(jsonBox.Value) then
			Library:Notify("Config imported", 3)
		else
			Library:Notify("That isn't a valid config", 3)
		end
	end)
	rg:AddButton("Reset everything to default", function()
		Library:ApplyConfig(baseline, false)
		Library:Notify("Reset to defaults", 3)
	end)

	local ag = tab:AddGroup("Autoload", "Right")
	local AUTO = FOLDER .. "/autoload.txt"
	ag:AddButton("Autoload selected config", function()
		if not fsOK() then
			Library:Notify("Autoload needs file access (executor)", 3)
			return
		end
		pcall(function()
			if not isfolder(FOLDER) then
				makefolder(FOLDER)
			end
			writefile(AUTO, list.Value)
		end)
		Library:Notify("Autoload: " .. tostring(list.Value), 3)
	end)
	ag:AddButton("Clear autoload", function()
		if fsOK() and type(delfile) == "function" then
			pcall(delfile, AUTO)
		end
		Library:Notify("Autoload cleared", 3)
	end)
	ag:AddLabel("Autoload runs when the script starts.")

	-- run the autoload config (if any) once the UI is ready
	task.defer(function()
		if not fsOK() or type(isfile) ~= "function" then
			return
		end
		local ok, sel = pcall(function()
			return isfile(AUTO) and readfile(AUTO) or nil
		end)
		if ok and sel and sel ~= "" then
			local b = builtinFor(sel)
			if b then
				applyFree(b)
			else
				local json = readSaved(sel)
				if json then
					Library:ImportConfig(json)
				end
			end
			Library:Notify("Autoloaded config: " .. sel, 3)
		end
	end)
end

return Graphics

end

