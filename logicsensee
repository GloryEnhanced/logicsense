---------------------------------------------------------------- camera (FOV, hold-to-zoom, zoom distance)
local CAM_BIND = PREFIX .. "Camera"
local CameraMod = {
	tr = newTracker(),
	FovOn = false, Fov = 90,
	ZoomOn = false, ZoomFov = 30, Zooming = false,
}

function CameraMod:_update()
	local need = self.FovOn or self.ZoomOn
	if need and not self.bound then
		local cam = workspace.CurrentCamera
		self.orig = cam and cam.FieldOfView or 70
		self.cur = nil
		self.bound = true
		-- runs right AFTER Roblox's own camera step so games can't overwrite the value
		RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
			local c = workspace.CurrentCamera
			if not c then
				return
			end
			local target = (self.ZoomOn and self.Zooming) and self.ZoomFov or (self.FovOn and self.Fov or self.orig)
			self.cur = self.cur and (self.cur + (target - self.cur) * math.min(1, dt * 14)) or target
			c.FieldOfView = self.cur
		end)
	elseif not need and self.bound then
		self.bound = false
		RunService:UnbindFromRenderStep(CAM_BIND)
		local c = workspace.CurrentCamera
		if c and self.orig then
			c.FieldOfView = self.orig
		end
	end
end

function CameraMod:SetZoomDistance(max)
	if max then
		track(self.tr, LocalPlayer, "CameraMaxZoomDistance", max)
		track(self.tr, LocalPlayer, "CameraMinZoomDistance", 0)
	else
		restore(self.tr)
	end
end

function CameraMod:Destroy()
	self.FovOn, self.ZoomOn, self.Zooming = false, false, false
	self:_update()
	restore(self.tr)
end

Graphics.CameraMod = CameraMod

