---------------------------------------------------------------- helpers
local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library._conns, c)
	return c
end

local function New(class, props, children)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		inst.Font = Library.Font
		inst.TextSize = Library.TextSize
		inst.TextColor3 = THEME.Text
		inst.TextStrokeColor3 = Color3.new(0, 0, 0) -- gamesense-style text shadow
		inst.TextStrokeTransparency = 0.55
		inst.BackgroundTransparency = 1
		inst.TextXAlignment = LEFT
		if class == "TextButton" then
			inst.AutoButtonColor = false
			inst.Text = ""
		end
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, ch in ipairs(children or {}) do
		ch.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function Pad(l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
	})
end

local function GradBar(parent, height)
	local f = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, height or 2),
		ZIndex = 5,
		Parent = parent,
	})
	New("UIGradient", { Color = GRADIENT, Parent = f })
	return f
end

-- vertical accent gradient fill
local function AccentFill(parent)
	local f = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	New("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(THEME.Accent, THEME.AccentDark),
		Parent = f,
	})
	return f
end

-- 3-layer panel (black border, grey border, background)
local function Panel(parent, size)
	local outer = New("Frame", {
		BackgroundColor3 = THEME.Outer,
		Size = UDim2.fromOffset(size.X, size.Y),
		Parent = parent,
	})
	local mid = New("Frame", {
		BackgroundColor3 = THEME.Group,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		Parent = outer,
	})
	local inner = New("Frame", {
		BackgroundColor3 = THEME.Background,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		Parent = mid,
	})
	return outer, inner
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

-- calls onMove(position) while the pointer is held on `handle`.
-- Performance: ONE shared InputChanged/InputEnded connection (made in Library:_Init)
-- instead of two per slider / color picker, so mouse movement stays cheap.
local activeDrag = nil
local activeScroll = nil
local function Dragger(handle, onMove)
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			activeDrag = onMove
			-- touch: stop the page from scrolling while a slider / picker is being dragged
			local sf = handle:FindFirstAncestorOfClass("ScrollingFrame")
			if sf then
				sf.ScrollingEnabled = false
				activeScroll = sf
			end
			onMove(i.Position)
		end
	end)
end

local function MakeDraggable(handle, target)
	local dragging, startMouse, startPos = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging, startMouse, startPos = true, i.Position, target.Position
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and isMove(i) then
			local d = i.Position - startMouse
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if isPress(i) then
			dragging = false
		end
	end)
end

---------------------------------------------------------------- popups
local function ClosePopup()
	if Library._popup then
		Library._popup.Visible = false
		Library._popup = nil
	end
	if Library.Catcher then
		Library.Catcher.Visible = false
	end
end

local function OpenPopup(frame)
	ClosePopup()
	Library._popup = frame
	frame.Visible = true
	Library.Catcher.Visible = true
end

---------------------------------------------------------------- option base
local function Fire(obj)
	if obj.Flag then
		Library.Flags[obj.Flag] = obj.Value
	end
	if obj.Callback then
		task.spawn(obj.Callback, obj.Value)
	end
	for _, fn in ipairs(obj._changed) do
		task.spawn(fn, obj.Value)
	end
end

local function Base(flag, o, value, typ)
	local obj = {
		Flag = flag,
		Value = value,
		Default = o.Default,
		Text = o.Text,
		Callback = o.Callback,
		NoConfig = o.NoConfig, -- not saved/loaded in configs (UI-only options)
		NoReset = o.NoReset, -- not touched when a config resets toggles
		_changed = {},
		Type = typ,
	}
	function obj:OnChanged(fn)
		table.insert(self._changed, fn)
	end
	if flag then
		Library.Flags[flag] = value
		Library.Options[flag] = obj
	end
	return obj
end

---------------------------------------------------------------- init
function Library:_Init()
	if self.Gui then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	self.Gui = New("ScreenGui", {
		Name = "SkeetUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1000,
		Parent = playerGui,
	})
	self.Catcher = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 90,
		Parent = self.Gui,
	})
	self.Catcher.MouseButton1Click:Connect(ClosePopup)
	self.Catcher.MouseButton2Click:Connect(ClosePopup)

	-- shared drag dispatcher
	connect(UIS.InputChanged, function(i)
		if activeDrag and isMove(i) then
			activeDrag(i.Position)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if activeDrag and isPress(i) then
			activeDrag = nil
			if activeScroll then
				activeScroll.ScrollingEnabled = true
				activeScroll = nil
			end
		end
	end)

	-- popups (dropdowns, color pickers) live in their own layer so they can be scaled with the window
	self.Touch = UIS.TouchEnabled and not UIS.KeyboardEnabled
	self.Scale = 1
	self.PopLayer = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(),
		ZIndex = 100,
		Parent = self.Gui,
	})
	self.PopScale = New("UIScale", { Parent = self.PopLayer })

	-- one stats ticker for the whole UI (watermark, live stats, auto booster all read from it)
	self._stats = {}
	local acc, frames = 0, 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		frames += 1
		if acc >= 0.5 then
			self.FPS = math.floor(frames / acc + 0.5)
			self.FrameMs = 1000 * acc / frames
			acc, frames = 0, 0
			for _, fn in ipairs(self._stats) do
				pcall(fn, self.FPS, self.FrameMs)
			end
		end
	end)

	self.NotifyHolder = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(320, 400),
		ZIndex = 120,
		Parent = self.Gui,
	}, {
		New("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

---------------------------------------------------------------- notifications / watermark
function Library:Notify(text, duration)
	self:_Init()
	local w = TextService:GetTextSize(text, self.TextSize, self.Font, Vector2.new(1000, 100)).X + 30
	-- the row keeps its slot in the list; the panel slides in/out inside it
	local row = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(w, 26),
		ClipsDescendants = true,
		ZIndex = 120,
		Parent = self.NotifyHolder,
	})
	local outer, inner = Panel(row, Vector2.new(w, 26))
	outer.ZIndex = 120
	outer.Position = UDim2.fromOffset(-w - 8, 0)
	GradBar(inner, 2)
	New("Frame", {
		BackgroundColor3 = THEME.Accent,
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(0, 2, 1, -2),
		Parent = inner,
	})
	New("TextLabel", {
		Text = text,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(11, 1),
		TextColor3 = THEME.TextBright,
		Parent = inner,
	})
	TweenService:Create(outer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(0, 0),
	}):Play()
	task.delay(duration or 3, function()
		if not outer.Parent then
			return
		end
		local t = TweenService:Create(outer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.fromOffset(-w - 8, 0),
		})
		t.Completed:Once(function()
			if row.Parent then
				row:Destroy()
			end
		end)
		t:Play()
	end)
end

-- fn(fps, frameMs) is called every 0.5s from the shared ticker
function Library:OnStats(fn)
	self:_Init()
	table.insert(self._stats, fn)
end

---------------------------------------------------------------- keybind list overlay (gamesense hotkey list)
function Library:_UpdateKeyList()
	local kl = self._keylist
	if not kl or not kl.holder.Visible then
		return
	end
	for _, c in ipairs(kl.content:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local n = 0
	for _, K in ipairs(self._kbs) do
		if K.State and K.Mode ~= "Always" then
			n += 1
			New("TextLabel", {
				Text = string.format("[%s] %s", K.Mode == "Hold" and "holding" or "toggled", K.ListText or "?"),
				TextColor3 = THEME.TextBright,
				Size = UDim2.new(1, 0, 0, 14),
				LayoutOrder = n,
				Parent = kl.content,
			})
		end
	end
end

