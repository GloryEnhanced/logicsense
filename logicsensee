function Graphics:BuildTabs(Library, Window)
	local self_ = self
	local O = Library.Options

	local boosterToggles = {
		{ "shadows", "Disable shadows" },
		{ "particles", "Disable particles & trails" },
		{ "postfx", "Disable game post-processing" },
		{ "water", "Flatten water" },
		{ "meshes", "Low mesh detail" },
		{ "decor", "Hide terrain decoration" },
		{ "quality", "Lowest graphics quality" },
		{ "lights", "Disable point / spot lights" },
		{ "envmap", "Disable environment reflections" },
		{ "reflect", "Remove part reflections" },
		{ "skyfx", "Disable atmosphere & clouds" },
		{ "gui3d", "Disable billboard / surface GUIs" },
		{ "highlights", "Disable highlights" },
		{ "otheracc", "Hide other players' accessories" },
		{ "cull", "Distance culling" },
	}
	local textureToggles = {
		{ "decals", "Decals & textures" },
		{ "surface", "PBR surface appearance" },
		{ "meshtex", "Mesh textures" },
		{ "clothing", "Clothing textures" },
	}

	local allFlags = {}
	for _, t in ipairs(boosterToggles) do table.insert(allFlags, "fps_" .. t[1]) end
	for _, t in ipairs(textureToggles) do table.insert(allFlags, "tex_" .. t[1]) end
	table.insert(allFlags, "tex_flat")

	local function setFlags(map)
		for _, flag in ipairs(allFlags) do
			if O[flag] then
				O[flag]:Set(map[flag] == true)
			end
		end
	end

	local presets = {
		["Off"] = {},
		["Light"] = { fps_shadows = true, fps_particles = true, fps_postfx = true },
		["Balanced"] = {
			fps_shadows = true, fps_particles = true, fps_postfx = true, fps_water = true,
			fps_decor = true, fps_meshes = true, fps_lights = true, fps_skyfx = true,
			fps_reflect = true, fps_highlights = true, tex_flat = true,
		},
		["Extreme"] = {
			fps_shadows = true, fps_particles = true, fps_postfx = true, fps_water = true,
			fps_meshes = true, fps_decor = true, fps_quality = true, fps_lights = true,
			fps_envmap = true, fps_reflect = true, fps_skyfx = true, fps_gui3d = true,
			fps_highlights = true, fps_otheracc = true,
			tex_decals = true, tex_surface = true, tex_meshtex = true, tex_clothing = true, tex_flat = true,
		},
		["Potato (200+ FPS)"] = {
			fps_shadows = true, fps_particles = true, fps_postfx = true, fps_water = true,
			fps_meshes = true, fps_decor = true, fps_quality = true, fps_lights = true,
			fps_envmap = true, fps_reflect = true, fps_skyfx = true, fps_gui3d = true,
			fps_highlights = true, fps_otheracc = true, fps_cull = true,
			tex_decals = true, tex_surface = true, tex_meshtex = true, tex_clothing = true, tex_flat = true,
		},
	}

	-- order the auto booster switches things on, cheapest-looking / biggest-win first
	local autoLevels = {
		"fps_shadows", "fps_particles", "fps_postfx", "fps_lights", "fps_skyfx", "fps_water",
		"fps_decor", "fps_reflect", "fps_meshes", "fps_envmap", "fps_highlights", "tex_flat",
		"fps_gui3d", "fps_quality", "tex_decals", "tex_surface", "tex_meshtex", "tex_clothing",
		"fps_otheracc", "fps_cull",
	}

	---------------------------------------------------------------- FPS tab
	local fps = Window:AddTab("FPS")
	local g = fps:AddGroup("FPS Booster", "Left")
	g:AddDropdown("fps_preset", {
		Text = "Preset",
		NoConfig = true, -- an action, not state: configs set the individual toggles instead
		Values = { "Off", "Light", "Balanced", "Extreme", "Potato (200+ FPS)" },
		Default = 1,
		Callback = function(v)
			setFlags(presets[v])
			Library:Notify("FPS booster: " .. v, 2)
		end,
	})
	for _, t in ipairs(boosterToggles) do
		g:AddToggle("fps_" .. t[1], {
			Text = t[2],
			Callback = function(v)
				self_:SetFeature("Booster", t[1], v)
			end,
		})
	end
	g:AddSlider("fps_cull_dist", {
		Text = "Culling distance", Min = 50, Max = 1500, Default = 300, Increment = 10, Suffix = " studs",
		Callback = function(v)
			self_.CullDistance = v
		end,
	})
	g:AddSlider("fps_budget", {
		Text = "Apply speed (lower = smoother)", Min = 0.5, Max = 10, Default = 2.5, Increment = 0.5, Suffix = " ms",
		NoConfig = true,
		Callback = function(v)
			self_.Budget = v / 1000
		end,
	})

	---------------- FPS cap + auto booster
	local cap = fps:AddGroup("FPS cap & auto boost", "Right")
	local capValues = { "Game default", "60", "144", "165", "200", "240", "360", "Unlimited" }
	self_.Cap = nil
	cap:AddDropdown("fps_cap", {
		Text = "FPS cap (needs executor setfpscap)",
		Values = capValues,
		Default = 1,
		Callback = function(v)
			if v == "Game default" then
				self_.Cap = nil
				return
			end
			local n = (v == "Unlimited") and 1000 or tonumber(v)
			self_.Cap = n
			local fn = (getgenv and getgenv().setfpscap) or setfpscap
			if type(fn) == "function" then
				pcall(fn, n)
			elseif Library.Flags["fps_cap_warned"] ~= true then
				Library.Flags["fps_cap_warned"] = true
				Library:Notify("Your executor has no setfpscap - Roblox keeps its own cap", 4)
			end
		end,
	})
	local autoOn, autoIdx, autoWait, autoEnabled = false, 0, 0, {}
	cap:AddToggle("fps_auto", {
		Text = "Auto booster (reaches target FPS)",
		Callback = function(v)
			autoOn = v
			if not v then
				for _, flag in ipairs(autoEnabled) do
					if O[flag] then
						O[flag]:Set(false)
					end
				end
				autoEnabled, autoIdx, autoWait = {}, 0, 0
			end
		end,
	})
	cap:AddSlider("fps_target", {
		Text = "Target FPS", Min = 60, Max = 360, Default = 200, Increment = 10,
	})
	Library:OnStats(function(cur)
		if not autoOn then
			return
		end
		if autoWait > 0 then
			autoWait -= 1 -- let the frame rate settle after each change
			return
		end
		local target = Library.Flags["fps_target"] or 200
		if self_.Cap then
			target = math.min(target, self_.Cap * 0.95) -- never chase a number the cap makes impossible
		end
		if cur < target and autoIdx < #autoLevels then
			autoIdx += 1
			local flag = autoLevels[autoIdx]
			local o = O[flag]
			if o and not o.Value then
				o:Set(true)
				autoEnabled[#autoEnabled + 1] = flag
				Library:Notify(string.format("Auto boost: %s (%d fps)", o.Text or flag, cur), 2)
			end
			autoWait = 4
		end
	end)

	local stats = fps:AddGroup("Live stats", "Right")
	local fpsLabel = stats:AddLabel("FPS: ...")
	local frameLabel = stats:AddLabel("Frame time: ...")
	local memLabel = stats:AddLabel("Memory: ...")
	Library:OnStats(function(f, ms)
		if not Library.MenuVisible then
			return -- no UI work while the menu is closed
		end
		fpsLabel:SetText(string.format("FPS: %d", f))
		frameLabel:SetText(string.format("Frame time: %.1f ms", ms))
		local ok, mem = pcall(function()
			return Stats:GetTotalMemoryUsageMb()
		end)
		memLabel:SetText(ok and string.format("Memory: %d MB", mem) or "Memory: n/a")
	end)

	local actions = fps:AddGroup("Quick actions", "Right")
	actions:AddButton("Revert everything", function()
		O["fps_auto"]:Set(false)
		setFlags({})
		O["fps_preset"]:Set("Off")
		O["shader_preset"]:Set("Off (none)")
		O["sky_preset"]:Set("Off (game default)")
		self_:RevertVisuals()
		Library:Notify("All graphics changes reverted", 3)
	end)

	---------------------------------------------------------------- Textures tab
	local tex = Window:AddTab("Textures")
	local tg = tex:AddGroup("Remove textures", "Left")
	for _, t in ipairs(textureToggles) do
		tg:AddToggle("tex_" .. t[1], {
			Text = t[2],
			Callback = function(v)
				self_:SetFeature("Textures", t[1], v)
			end,
		})
	end
