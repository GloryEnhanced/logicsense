-- Call this AFTER every other tab is built: it snapshots the default state of all options.
function Graphics:BuildConfigs(Library, Window)
	local O = Library.Options
	local HttpService = game:GetService("HttpService")
	local FOLDER = "logicsense"
	local FREE = "[free] "

	---------------------------------------------------------------- built-in free configs
	local function on(...)
		local t = {}
		for _, k in ipairs({ ... }) do
			t[k] = true
		end
		return t
	end
	local function merge(...)
		local out = {}
		for _, t in ipairs({ ... }) do
			for k, v in pairs(t) do
				out[k] = v
			end
		end
		return out
	end
	local BOOST_ALL = on(
		"fps_shadows", "fps_particles", "fps_postfx", "fps_water", "fps_meshes", "fps_decor", "fps_quality",
		"fps_lights", "fps_envmap", "fps_reflect", "fps_skyfx", "fps_gui3d", "fps_highlights", "fps_otheracc",
