	"Off", "Rain", "Heavy Rain", "Snow", "Blizzard", "Ash", "Embers", "Fireflies", "Sakura Petals", "Sandstorm", "Stars",
}

local Weather = { Type = "Off", Intensity = 1, Wind = 0, Order = WEATHER_ORDER, Override = nil }

function Weather:Clear()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	if self.part then
		self.part:Destroy()
		self.part, self.emitter = nil, nil
	end
end

function Weather:Apply()
	local p = WEATHER[self.Type]
	if not p then
		return self:Clear()
	end
	if not self.part or not self.part.Parent then
		self:Clear()
		local part = Instance.new("Part")
		part.Name = PREFIX .. "Weather"
		part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = true, false, false, false, false
		part.Transparency = 1
		part.Parent = workspace.CurrentCamera or workspace
		local em = Instance.new("ParticleEmitter")
		em.Parent = part
		self.part, self.emitter = part, em
		self.conn = RunService.Heartbeat:Connect(function()
			local cam = workspace.CurrentCamera
			local cur = WEATHER[self.Type]
			if cam and cur and self.part then
				self.part.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, cur.Height, 0))
			end
		end)
	end
	self.part.Size = p.Area
	local em = self.emitter
	local col = self.Override or p.Color
	em.Texture = p.Texture
	em.Rate = p.Rate * self.Intensity
	em.Lifetime = p.Life
	em.Speed = p.Speed
	em.Size = NumberSequence.new(p.Size)
	em.Color = ColorSequence.new(col)
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.1, p.Alpha),
		NumberSequenceKeypoint.new(0.9, p.Alpha),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Acceleration = p.Accel + Vector3.new(self.Wind, 0, self.Wind * 0.3)
	em.SpreadAngle = Vector2.new(p.Spread, p.Spread)
	em.EmissionDirection = p.Dir
	em.LightEmission = p.Glow or 0
	em.Orientation = p.Parallel and Enum.ParticleOrientation.VelocityParallel or Enum.ParticleOrientation.FacingCamera
	em.LockedToPart = false
	em.Enabled = true
end

function Weather:Set(key, value)
	self[key] = value
	self:Apply()
end

