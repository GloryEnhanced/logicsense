        Graphics:Destroy()                           -- revert everything
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Graphics = {}
local PREFIX = "SkeetUI_"

---------------------------------------------------------------- change tracking
local function weak()
	return setmetatable({}, { __mode = "k" })
end

local function newTracker()
	return { props = weak(), parents = weak(), conns = {}, n = 0 }
end

-- PERFORMANCE: no closures are created per call (pcall gets a shared function + arguments),
-- originals are stored raw (not boxed in a table), and nothing is touched when the value is
-- already what we want (so already-flat / already-off instances cost almost nothing).
local function getProp(inst, prop)
	return inst[prop]
end
local function setProp(inst, prop, value)
	inst[prop] = value
end

-- set a property but remember the original so restore() can undo it
local function track(tr, inst, prop, value)
	local ok, cur = pcall(getProp, inst, prop)
	if not ok or cur == value then
		return
	end
	local rec = tr.props[inst]
	if not rec then
		rec = {}
		tr.props[inst] = rec
		tr.n += 1
	end
	if rec[prop] == nil then
		rec[prop] = cur -- (false is a valid original, so only nil means "not recorded")
	end
	pcall(setProp, inst, prop, value)
end

-- remove an instance from the game but remember where it was
local function detach(tr, inst)
	local p = inst.Parent
	if p then
		tr.parents[inst] = p
		tr.n += 1
		inst.Parent = nil
	end
end

local function restoreEntries(props, parents)
	local t0, count = os.clock(), 0
	for inst, parent in pairs(parents) do
		if parent == game or parent:IsDescendantOf(game) then
			pcall(setProp, inst, "Parent", parent)
		end
		count += 1
		if count % 32 == 0 and os.clock() - t0 > 0.002 then
			task.wait()
			t0 = os.clock()
		end
	end
	for inst, rec in pairs(props) do
		for prop, original in pairs(rec) do
			pcall(setProp, inst, prop, original)
		end
		count += 1
		if count % 32 == 0 and os.clock() - t0 > 0.002 then
			task.wait()
			t0 = os.clock()
		end
	end
end

-- big trackers (thousands of parts) are restored over several frames so turning a
-- feature off can't freeze the game either
local function restore(tr)
	for _, c in ipairs(tr.conns) do
		c:Disconnect()
	end
	tr.conns = {}
	local props, parents, n = tr.props, tr.parents, tr.n
	tr.props, tr.parents, tr.n = weak(), weak(), 0
	if n > 400 then
		task.spawn(restoreEntries, props, parents)
	else
		for inst, parent in pairs(parents) do
			if parent == game or parent:IsDescendantOf(game) then
				pcall(setProp, inst, "Parent", parent)
			end
		end
		for inst, rec in pairs(props) do
			for prop, original in pairs(rec) do
				pcall(setProp, inst, prop, original)
			end
		end
	end
end

local function isOurs(d)
	return string.sub(d.Name, 1, #PREFIX) == PREFIX
end

local function isPart(d)
	return d:IsA("BasePart") and not d:IsA("Terrain")
end

---------------------------------------------------------------- feature factory
-- def.Global(tr)   : runs once when enabled
-- def.Inst(tr, d)  : runs for every existing + newly added workspace descendant
-- PERFORMANCE / STABILITY:
--  * every Inst feature shares ONE workspace.DescendantAdded connection and ONE scan of the workspace
--  * ALL work (initial scan + newly added instances) runs through a single Heartbeat pump with a
--    per-frame TIME BUDGET (Graphics.Budget, default 2.5 ms). The pump shrinks its budget further when
--    the frame rate is already low, so enabling many features at once (max FPS preset) stays smooth
--    instead of freezing the game while thousands of properties change in one frame.
Graphics.Budget = 0.0025

local activeInst = {} -- features currently enabled that have an Inst handler
local activeCount = 0
local dispatchConn = nil
local pumpConn = nil
local jobs = {} -- { feats = {...}, list = {...}, i = next index }
local incoming, inHead, inTail = {}, 1, 0 -- queue of newly added instances
local pendingFeats, flushScheduled = {}, false

local function pump(dt)
	local t0 = os.clock()
	local budget = Graphics.Budget
	if dt > 0.022 then
		budget = math.min(budget, 0.001) -- already below ~45 fps: back off
	end
	-- 1) newly added instances first, so new objects don't pop in unboosted
	while inHead <= inTail do
		local d = incoming[inHead]
		incoming[inHead] = nil
		inHead += 1
		if d.Parent then
			for f in pairs(activeInst) do
				pcall(f.def.Inst, f.tr, d)
			end
		end
		if inHead % 16 == 0 and os.clock() - t0 > budget then
			return
		end
	end
	inHead, inTail = 1, 0
	-- 2) initial scans of the existing workspace
	local job = jobs[1]
	if not job then
		if pumpConn and activeCount <= 0 then
			pumpConn:Disconnect()
			pumpConn = nil
		end
		return
	end
	local list, feats = job.list, job.feats
	local nf, n, i = #feats, #list, job.i
	while i <= n do
		local d = list[i]
		i += 1
		for k = 1, nf do
			local F = feats[k]
			if F.Enabled then
				pcall(F.def.Inst, F.tr, d)
			end
		end
		if i % 16 == 0 and os.clock() - t0 > budget then
			break
		end
	end
	job.i = i
	if i > n then
		table.remove(jobs, 1)
	end
end

local function ensurePump()
	if not pumpConn then
		pumpConn = RunService.Heartbeat:Connect(pump)
	end
end

local function flushPending()
	flushScheduled = false
	local live = {}
	for _, F in ipairs(pendingFeats) do
		if F.Enabled then
			live[#live + 1] = F
		end
	end
	pendingFeats = {}
	if #live > 0 then
		jobs[#jobs + 1] = { feats = live, list = workspace:GetDescendants(), i = 1 }
		ensurePump()
	end
end

local function stopPump()
	if pumpConn then
		pumpConn:Disconnect()
		pumpConn = nil
	end
	if dispatchConn then
		dispatchConn:Disconnect()
		dispatchConn = nil
	end
	jobs, incoming, inHead, inTail, pendingFeats = {}, {}, 1, 0, {}
	activeInst, activeCount = {}, 0
end

local function addActive(F)
	if activeInst[F] then
		return
	end
	activeInst[F] = true
	activeCount += 1
	if not dispatchConn then
		dispatchConn = workspace.DescendantAdded:Connect(function(d)
			inTail += 1
			incoming[inTail] = d -- just queue it; the pump does the work within its budget
			ensurePump()
		end)
	end
end

local function removeActive(F)
	if activeInst[F] then
		activeInst[F] = nil
		activeCount -= 1
		if activeCount <= 0 and dispatchConn then
			dispatchConn:Disconnect()
			dispatchConn = nil
			activeCount = 0
		end
	end
end

local function Feature(def)
	local F = { Enabled = false, tr = newTracker(), def = def }

	function F:Enable()
		if self.Enabled then
			return
		end
		self.Enabled = true
		if def.Global then
			pcall(def.Global, self.tr)
		end
		if def.Inst then
			addActive(self)
			pendingFeats[#pendingFeats + 1] = self
			if not flushScheduled then
				flushScheduled = true
				task.defer(flushPending) -- batch everything enabled this frame into ONE scan
			end
		end
	end

	function F:Disable()
		if not self.Enabled then
			return
		end
		self.Enabled = false
		removeActive(self)
		restore(self.tr)
	end

	return F
end

