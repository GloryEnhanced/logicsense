function Library:SetWatermark(text)
	self:_Init()
	if not text then
		if self._wm then
			self._wm.Visible = false
		end
		return
	end
	self._wmText = text
	if not self._wm then
		local outer = New("Frame", {
			BackgroundColor3 = THEME.Outer,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			ZIndex = 110,
			Parent = self.Gui,
		}, { Pad(1, 1, 1, 1) })
		local inner = New("Frame", {
			BackgroundColor3 = THEME.Background,
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = outer,
		})
		GradBar(inner, 2)
		self._wmLabel = New("TextLabel", {
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			TextColor3 = THEME.TextBright,
			Parent = inner,
		}, { Pad(9, 2, 9, 0) })
		self._wm = outer

		self:OnStats(function(fps)
			if self._wm and self._wm.Visible and self._wmLabel then
				self._wmLabel.Text = (self._wmText or "") .. " | " .. fps .. " fps"
			end
		end)
	end
	self._wm.Visible = true
	self._wmLabel.Text = text
end

---------------------------------------------------------------- config
function Library:ExportConfig()
	local data = {}
	for flag, opt in pairs(self.Options) do
		if opt.NoConfig then
			continue
		end
		local v = opt.Value
		if typeof(v) == "Color3" then
			v = { __color = v:ToHex() }
		elseif typeof(v) == "EnumItem" then
			v = { __key = v.Name }
		elseif v == nil then
			continue
		end
		data[flag] = v
	end
	return HttpService:JSONEncode(data)
end

function Library:ImportConfig(json)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(data) ~= "table" then
		return false
	end
	return self:ApplyConfig(data, false)
end

-- data = { flag = value }, values may be Color3 / {__color=hex} / {__key=name}.
-- reset = true switches every other toggle back to its default first.
-- Dropdowns are applied first, then sliders/colors, then toggles, so presets never overwrite explicit values.
function Library:ApplyConfig(data, reset)
	if type(data) ~= "table" then
		return false
	end
	if reset then
		for flag, opt in pairs(self.Options) do
			if opt.Type == "Toggle" and not opt.NoConfig and not opt.NoReset and data[flag] == nil and opt.Set then
				pcall(opt.Set, opt, opt.Default == true)
			end
		end
	end
	local order = { Dropdown = 1, Textbox = 2, Keybind = 2, Slider = 3, ColorPicker = 3, Toggle = 4 }
	local list = {}
	for flag, v in pairs(data) do
		local opt = self.Options[flag]
		if opt and opt.Set and not opt.NoConfig then
			if type(v) == "table" and v.__color then
				v = Color3.fromHex(v.__color)
			elseif type(v) == "table" and v.__key then
				v = v.__key
			end
			-- skip options that already hold this value (keeps config loads fast: no pointless callbacks)
			if type(v) == "table" or opt.Value ~= v then
				list[#list + 1] = { flag, opt, v }
			end
		end
	end
	table.sort(list, function(a, b)
		local oa, ob = order[a[2].Type] or 3, order[b[2].Type] or 3
		if oa ~= ob then
			return oa < ob
		end
		return a[1] < b[1]
	end)
	for _, e in ipairs(list) do
		pcall(e[2].Set, e[2], e[3])
	end
	return true
end

function Library:Unload()
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	table.clear(self._conns)
	if self.Gui then
		self.Gui:Destroy()
	end
	self.Gui, self.Catcher, self._wm, self._wmLabel, self._popup = nil, nil, nil, nil, nil
	self.PopLayer, self.PopScale = nil, nil
	self._keylist, self._kbs, self._stats = nil, {}, {}
	activeDrag, activeScroll = nil, nil
	table.clear(self.Flags)
	table.clear(self.Options)
end

---------------------------------------------------------------- color picker
local function AddColorPicker(parent, flag, o, rightOffset)
	o = o or {}
	local P = Base(flag, o, o.Default or Color3.new(1, 1, 1), "ColorPicker")
	local h, s, v = P.Value:ToHSV()

	local swOuter = New("Frame", {
		BackgroundColor3 = THEME.Outer,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -(rightOffset or 0), 0, 3),
		Size = UDim2.fromOffset(20, 10),
		Parent = parent,
	})
	local sw = New("TextButton", {
		BackgroundColor3 = P.Value,
		BackgroundTransparency = 0,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		Parent = swOuter,
	})

	local pop, inner = Panel(Library.PopLayer, Vector2.new(164, 132))
	pop.Visible = false
	pop.ZIndex = 100

	local sv = New("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(144, 90),
		Parent = inner,
	})
	local white = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = sv })
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), Parent = sv })
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local svMark = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(5, 5),
		ZIndex = 3,
		Parent = sv,
	}, { New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }) })

	local hue = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(8, 106),
		Size = UDim2.fromOffset(144, 12),
		Parent = inner,
	})
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
		}),
		Parent = hue,
	})
	local hueMark = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 14),
		ZIndex = 3,
		Parent = hue,
	}, { New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }) })

	local function update(fire)
		P.Value = Color3.fromHSV(h, s, v)
		sw.BackgroundColor3 = P.Value
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svMark.Position = UDim2.fromScale(s, 1 - v)
		hueMark.Position = UDim2.fromScale(h, 0.5)
		if fire then
			Fire(P)
		end
	end
	update(false)

	Dragger(sv, function(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		update(true)
	end)
	Dragger(hue, function(pos)
		h = math.clamp((pos.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 0.999)
		update(true)
	end)

	function P:Set(c)
		if typeof(c) == "string" then
			c = Color3.fromHex(c)
		end
		h, s, v = c:ToHSV()
		update(true)
	end

	sw.MouseButton1Click:Connect(function()
		local ap = sw.AbsolutePosition
		local s = Library.Scale
		local gs = Library.Gui.AbsoluteSize
		local x = math.clamp(ap.X - 142 * s, 4, math.max(4, gs.X - 168 * s))
		local y = math.clamp(ap.Y + 14 * s, 4, math.max(4, gs.Y - 136 * s))
		pop.Position = UDim2.fromOffset(x / s, y / s)
		OpenPopup(pop)
	end)
	return P
end

---------------------------------------------------------------- window
function Library:CreateWindow(opts)
	opts = opts or {}
	self:_Init()

	local size = opts.Size or Vector2.new(620, 420)
	local Window = { Tabs = {}, ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift }

	local root = New("Frame", {
		Name = "Window",
		BackgroundColor3 = THEME.Outer,
		Size = UDim2.fromOffset(size.X, size.Y),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 1,
		Parent = self.Gui,
	})
	-- MOBILE / SMALL SCREENS: scale the whole window (and its popups) down to fit the viewport
	local winScale = New("UIScale", { Parent = root })
	local function fit()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local s = math.clamp(math.min((vp.X - 16) / size.X, (vp.Y - 16) / size.Y), 0.4, 1)
		Library.Scale = s
		winScale.Scale = s
		if Library.PopScale then
			Library.PopScale.Scale = s
		end
	end
	fit()
	do
		local cam = workspace.CurrentCamera
		if cam then
			connect(cam:GetPropertyChangedSignal("ViewportSize"), fit)
		end
	end
	local function layer(color, inset, z)
		return New("Frame", {
			BackgroundColor3 = color,
			Position = UDim2.fromOffset(inset, inset),
			Size = UDim2.new(1, -inset * 2, 1, -inset * 2),
			ZIndex = z,
			Parent = root,
		})
	end
	layer(THEME.Line, 1, 1)
	layer(THEME.Border, 2, 2)
	layer(THEME.Line, 5, 3)
	local body = layer(THEME.Background, 6, 4)
	body.ClipsDescendants = true

	local modal = New("TextButton", { Size = UDim2.new(), Modal = true, Parent = root })

	GradBar(body, 2)

