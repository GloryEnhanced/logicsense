local function stripInst(tr, d)
	if d:IsA("SurfaceAppearance") then
		detach(tr, d)
	elseif d:IsA("Decal") then
		track(tr, d, "Transparency", 1)
	elseif d:IsA("Shirt") then
		track(tr, d, "ShirtTemplate", "")
	elseif d:IsA("Pants") then
		track(tr, d, "PantsTemplate", "")
	elseif d:IsA("ShirtGraphic") then
		track(tr, d, "Graphic", "")
	elseif d:IsA("MeshPart") then
		track(tr, d, "TextureID", "")
	elseif d:IsA("SpecialMesh") then
		track(tr, d, "TextureId", "")
	end
end

function Character:_make(class, name, props, parent)
	local inst = Instance.new(class)
	inst.Name = PREFIX .. name
	for k, v in pairs(props) do
		pcall(function()
			inst[k] = v
		end)
	end
	inst.Parent = parent
	table.insert(self.created, inst)
	return inst
end

function Character:_paint(d)
	local S = self.S
	if not isPart(d) or isOurs(d) or d.Name == "HumanoidRootPart" or d.Transparency >= 1 then
		return
	end
	if not S.Accessories and d:FindFirstAncestorWhichIsA("Accessory") then
		return
	end
	local ok, mat = pcall(function()
		return Enum.Material[S.Material]
	end)
	if ok then
		track(self.tr, d, "Material", mat)
	end
	track(self.tr, d, "Color", S.Color)
	track(self.tr, d, "Reflectance", S.Reflectance)
	if S.Transparency > 0 then
		track(self.tr, d, "Transparency", math.max(d.Transparency, S.Transparency))
	end
	table.insert(self.parts, d)
end

function Character:_handle(d)
	if not self.S.Enabled or isOurs(d) then
		return
	end
	self:_paint(d)
	if self.S.Strip then
		stripInst(self.tr, d)
	end
end

-- rebuilds every character visual from the current settings (always restores first)
function Character:Refresh()
	restore(self.tr)
	for _, inst in ipairs(self.created) do
		pcall(function()
			inst:Destroy()
		end)
	end
	self.created, self.parts = {}, {}
	self.hl, self.trail, self.aura, self.light = nil, nil, nil, nil
	self.anim, self.auraParts = nil, nil

	local char = LocalPlayer.Character
	if not char then
		self:_updateLoop()
		return
	end
	local S = self.S

	if S.Enabled then
		for _, d in ipairs(char:GetDescendants()) do
			self:_handle(d)
		end
		table.insert(self.tr.conns, char.DescendantAdded:Connect(function(d)
			task.defer(function()
				self:_handle(d)
			end)
		end))
	end

	if S.Outline then
		self.hl = self:_make("Highlight", "Outline", {
			Adornee = char,
			FillColor = S.FillColor,
			FillTransparency = S.FillTransparency,
			OutlineColor = S.OutlineColor,
			OutlineTransparency = 0,
			DepthMode = Enum.HighlightDepthMode.Occluded,
		}, char)
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		if S.Trail then
			local a0 = self:_make("Attachment", "TrailA0", { Position = Vector3.new(0, 1, 0) }, hrp)
			local a1 = self:_make("Attachment", "TrailA1", { Position = Vector3.new(0, -1, 0) }, hrp)
			self.trail = self:_make("Trail", "Trail", {
				Attachment0 = a0,
				Attachment1 = a1,
				Lifetime = S.TrailLifetime,
				Color = ColorSequence.new(S.TrailColor),
				Transparency = NumberSequence.new(0, 1),
				LightEmission = 1,
				FaceCamera = true,
				MinLength = 0.05,
			}, hrp)
		end
		if S.Aura then
			local st = AURAS[S.AuraStyle] or AURAS["Orbs"]
			if st.Kind then
				self:_buildAuraParts(st)
			else
				local rot = st.Rot or 0
				self.aura = self:_make("ParticleEmitter", "Aura", {
					Texture = st.Tex,
					Rate = st.Rate * S.AuraIntensity,
					Lifetime = st.Life,
					Speed = st.Speed,
					SpreadAngle = Vector2.new(st.Spread, st.Spread),
					Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, st.S0 * S.AuraSize),
						NumberSequenceKeypoint.new(1, st.S1 * S.AuraSize),
					}),
					Transparency = NumberSequence.new(st.A0, 1),
					LightEmission = st.Glow,
					Color = ColorSequence.new(S.AuraColor, S.AuraColor2),
					Acceleration = st.Accel or Vector3.new(),
					Rotation = NumberRange.new(0, 360),
					RotSpeed = NumberRange.new(-rot, rot),
					Drag = st.Drag or 0,
				}, hrp)
			end
		end
		if S.Glow then
			self.light = self:_make("PointLight", "Glow", {
				Color = S.GlowColor,
				Range = S.GlowRange,
				Brightness = S.GlowBrightness,
				Shadows = false,
			}, hrp)
		end
		self.hrp = hrp
	end
	self:_updateLoop()
end

-- bead-based auras (halo / orbiting orbs / spiral / ground ring): small glowing parts that follow you.
-- They live under the camera, so only you see them.
function Character:_buildAuraParts(st)
	local S = self.S
	local folder = self:_make("Folder", "AuraParts", {}, workspace.CurrentCamera or workspace)
	local sz = S.AuraSize
	local n = st.Count
	local parts = {}
	for i = 1, n do
		local p = Instance.new("Part")
		p.Name = PREFIX .. "AuraBead"
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Material = Enum.Material.Neon
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(st.Bead * sz, st.Bead * sz, st.Bead * sz)
		p.Color = S.AuraColor:Lerp(S.AuraColor2, (i - 1) / math.max(n - 1, 1))
		p.Parent = folder
		parts[i] = p
	end
	self.auraParts = parts
	local kind = st.Kind
	local sin, cos, pi = math.sin, math.cos, math.pi
	self.anim = function(t, root)
		local pos = root.Position
		for i = 1, n do
			local p = parts[i]
			if kind == "orbit" then
				local a = t * 1.8 + i * (2 * pi / n)
				p.Position = pos + Vector3.new(cos(a) * 3.4 * sz, sin(t * 2 + i) * 0.8, sin(a) * 3.4 * sz)
			elseif kind == "halo" then
				local a = i * (2 * pi / n) + t * 0.8
				p.Position = pos + Vector3.new(cos(a) * 1.15 * sz, 3.3 + sin(t * 2) * 0.12, sin(a) * 1.15 * sz)
			elseif kind == "spiral" then
				local a = t * 2.2 + i * 0.75
				local h = ((i - 1) / math.max(n - 1, 1)) * 6.4 - 3 + sin(t + i) * 0.15
				local r = (2.1 + sin(i * 0.5 + t) * 0.35) * sz
				p.Position = pos + Vector3.new(cos(a) * r, h, sin(a) * r)
			else -- ground ring
				local a = i * (2 * pi / n) - t * 1.2
				local r = (2.7 + sin(t * 2) * 0.35) * sz
				p.Position = pos + Vector3.new(cos(a) * r, -2.85 + sin(t * 4 + i) * 0.12, sin(a) * r)
			end
		end
	end
end

-- the render loop only exists while something needs it (rainbow colors or an animated aura)
function Character:_updateLoop()
	local need = self.S.Rainbow or self.anim ~= nil
	if need and not self._loop then
		self._loop = RunService.RenderStepped:Connect(function()
			local S = self.S
			local t = os.clock()
			local root = self.hrp
			if self.anim and root and root.Parent then
				self.anim(t, root)
			end
			if not S.Rainbow then
				return
			end
			local c = Color3.fromHSV((t * S.RainbowSpeed) % 1, 0.85, 1)
			for _, p in ipairs(self.parts) do
				if p.Parent then
					p.Color = c
				end
			end
			if self.auraParts then
				for _, p in ipairs(self.auraParts) do
					p.Color = c
				end
			end
			if self.hl and self.hl.Parent then
				self.hl.OutlineColor = c
			end
			if self.trail and self.trail.Parent then
				self.trail.Color = ColorSequence.new(c)
			end
			if self.aura and self.aura.Parent then
				self.aura.Color = ColorSequence.new(c)
			end
			if self.light and self.light.Parent then
				self.light.Color = c
			end
		end)
	elseif not need and self._loop then
		self._loop:Disconnect()
		self._loop = nil
	end
end

function Character:Init()
	if self._init then
		return
	end
	self._init = true
	self._cconn = LocalPlayer.CharacterAdded:Connect(function(char)
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5) -- let the appearance load
		self:Refresh()
	end)
end

-- change a setting; rapid changes (slider drags) are coalesced into one refresh
function Character:Set(key, value)
	self.S[key] = value
	self:Init()
	if self._pending then
		return
	end
	self._pending = true
	task.defer(function()
		self._pending = false
		self:Refresh()
	end)
end

function Character:Destroy()
	for _, k in ipairs({ "Enabled", "Outline", "Trail", "Aura", "Glow", "Rainbow" }) do
		self.S[k] = false
	end
	self:Refresh()
	if self._cconn then
		self._cconn:Disconnect()
		self._cconn = nil
	end
	if self._loop then
		self._loop:Disconnect()
		self._loop = nil
	end
	self._init = false
end

