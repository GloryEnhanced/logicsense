			end
		end,
	},
	otheracc = {
		-- other players' hats / accessories are a big part of the draw cost in crowded servers
		Inst = function(tr, d)
			if d:IsA("Accessory") then
				local me = Players.LocalPlayer and Players.LocalPlayer.Character
				if me and d:IsDescendantOf(me) then
					return
				end
				for _, p in ipairs(d:GetDescendants()) do
					if p:IsA("BasePart") then
						track(tr, p, "Transparency", 1)
					end
				end
			end
		end,
	},
	cull = {
		-- distance culling: parts farther than Graphics.CullDistance from the camera are hidden
		-- (fully transparent parts are skipped by the renderer). Time-sliced, ~250 parts per frame.
		Global = function(tr)
			local list, culled, cursor = {}, {}, 1
			tr.cull = { list = list }
			table.insert(tr.conns, RunService.Heartbeat:Connect(function()
				local n = #list
				local cam = workspace.CurrentCamera
				if n == 0 or not cam then
					return
				end
				local cp = cam.CFrame.Position
				local D = Graphics.CullDistance
				for _ = 1, math.min(250, n) do
					if cursor > n then
						cursor = 1
					end
					local p = list[cursor]
					if not p.Parent then
						list[cursor] = list[n]
						list[n] = nil
						n -= 1
						culled[p] = nil
					else
						local far = (p.Position - cp).Magnitude > D + p.Size.Magnitude * 0.5
						if far ~= (culled[p] == true) then
							culled[p] = far or nil
							p.LocalTransparencyModifier = far and 1 or 0
						end
						cursor += 1
					end
					if n == 0 then
						break
					end
				end
			end))
			table.insert(tr.conns, {
				Disconnect = function()
					for p in pairs(culled) do
						pcall(function()
							p.LocalTransparencyModifier = 0
						end)
					end
					table.clear(culled)
				end,
			})
		end,
		Inst = function(tr, d)
			if not tr.cull or not isPart(d) or d.Size.Magnitude > 250 then
				return
			end
			local m = d:FindFirstAncestorOfClass("Model")
			if m and m:FindFirstChildOfClass("Humanoid") then
				return -- never cull characters
			end
			table.insert(tr.cull.list, d)
		end,
	},
	decor = {
		Global = function(tr)
			track(tr, workspace.Terrain, "Decoration", false)
		end,
	},
	quality = {
		Global = function(tr)
			local ok, rendering = pcall(function()
				return settings().Rendering
			end)
			if ok then
				track(tr, rendering, "QualityLevel", Enum.QualityLevel.Level01)
			end
		end,
	},
}

